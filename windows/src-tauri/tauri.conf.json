{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Apex Location Director",
  "version": "0.1.0",
  "identifier": "com.lukeeidson.apexwin",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Apex Location Director",
        "width": 1040,
        "height": 740,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["DDI/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
